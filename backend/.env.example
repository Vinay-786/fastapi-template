# Postgres connection (generic dev credentials)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend
POSTGRES_PORT=5432

# asyncpg DSN (plain postgresql:// scheme, no ORM dialect)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend

# Debug mode: true enables FastAPI debug, auto-reload, and the interactive API
# docs (/docs, /redoc). Keep this false in production.
# Accepts: 1/true/yes/on (case-insensitive) for true; anything else is false.
DEBUG=true
